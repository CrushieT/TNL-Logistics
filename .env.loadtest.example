# Copy this file to .env.loadtest and replace every placeholder before starting the stack.
LOADTEST_DB_NAME=tnl_loadtest
LOADTEST_DB_USER=tnl_loadtest
LOADTEST_DB_PASSWORD=replace-with-a-local-loadtest-password
LOADTEST_DB_ROOT_PASSWORD=replace-with-a-local-root-password
LOADTEST_JWT_SECRET=replace-with-at-least-32-random-characters
LOADTEST_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Keep false for normal startup. Set true only while seeding an empty tnl_loadtest database.
LOADTEST_SEED_ENABLED=false
LOADTEST_SEED_SHIPMENTS=10000
LOADTEST_SEED_RANDOM_SEED=20260925
LOADTEST_SEED_BATCH_SIZE=250
LOADTEST_SEED_PASSWORD=replace-with-a-local-loadtest-password
