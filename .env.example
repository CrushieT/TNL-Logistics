# MySQL Database Config
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQL_DATABASE=tnl_dev
MYSQLUSER=root
MYSQLPASSWORD=your_password_here

# Server Port (Render or local)
PORT=8080

# CORS Allowed Origins (Comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://your-frontend.onrender.com

# JWT Signing Secret (Minimum 256 bits / 32 bytes)
JWT_SECRET=your-super-secret-key-that-needs-to-be-at-least-256-bits-long-tnl-logistics

