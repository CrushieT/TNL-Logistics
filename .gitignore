# --- General exclusions ---
.DS_Store
Thumbs.db
Desktop.ini
*.log
tmp/
.history/

# --- IDE and Editor settings ---
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
.settings/
.project
.classpath
.factorypath
.metadata/
bin/
*.code-workspace

# --- Environment files & Local Secrets ---
.env
.env.local
.env.*.local
*.env

# --- Backend (Maven / Java) exclusions ---
backend/target/
backend/pom.xml.tag
backend/pom.xml.releaseBackup
backend/pom.xml.next
backend/release.properties
backend/dependency-reduced-pom.xml
backend/buildNumber.properties
backend/.mvn/timing.properties

# --- Frontend Web (Next.js / React) exclusions ---
frontend-web/node_modules/
frontend-web/.next/
frontend-web/out/
frontend-web/build/

# --- Frontend Mobile (Expo / React Native) exclusions ---
frontend-mobile/node_modules/
frontend-mobile/.expo/
frontend-mobile/dist/
frontend-mobile/web-build/
frontend-mobile/npm-debug.log*
frontend-mobile/yarn-debug.log*
frontend-mobile/yarn-error.log*
frontend-mobile/.expo-shared/
