{
  "expo": {
    "name": "TNL Logistics Field",
    "slug": "tnl-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {},
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TNL Logistics to access your camera to scan parcel QR codes."
        }
      ],
      "expo-font"
    ],
    "scheme": "tnl-field"
  }
}
